<apex:page controller="ExpenseAndIncomePDFController" showHeader="false">

    <h1 style="text-align:center">
        Year-End Expenses Report
    </h1>

    <table border="1" width="100%" cellpadding="6">
        <tr>
            <th>Month</th>
            <apex:repeat value="{!categoryTnx}" var="category">
                <th>{!category}</th>
            </apex:repeat>
        </tr>

        <apex:repeat value="{!rows}" var="row">
            <tr>
                <td>{!row.month}</td>
                <apex:repeat value="{!categoryTnx}" var="category">
                    <td>{!row.values[category]}</td>
                </apex:repeat>
            </tr>
        </apex:repeat>
    </table>

    <p style="margin-top:20px;font-size:10px">
        Generated on {!TODAY()}
    </p>

</apex:page>