<apex:page controller="MoneyManagerController" showHeader="false" sidebar="false">
    <head>
        <style>
            body { font-family: 'Arial Unicode MS'; }
        </style> 
    </head>
    <body>

        <apex:sectionHeader title="Expense and Income Report" subtitle="Last one year data"/>
        <apex:pageBlock >
            <apex:pageBlockTable value="{!ExpenseData}" var="record">
                <apex:column headerValue="Category" value="{!record.Category__c}"/>
                <apex:column headerValue="Amount" value="{!record.Transaction_Amount}"/>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </body>
